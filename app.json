{
  "expo": {
    "name": "Glowdesk",
    "slug": "glowdesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glowdesk",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.irfana201.glowdesk"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#816C83",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#816C83",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Glowdesk uses the camera to scan product barcodes when picking Click & Collect orders.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
